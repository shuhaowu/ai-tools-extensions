{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "files": {
    "includes": [
      "packages/**/*.ts",
      "pi/extensions/**/*.ts",
      "opencode/plugins/**/*.ts",
      "opencode/plugins/**/*.tsx",
      "!!.pi/git/**/*",
    ]
  },
  "formatter": {
    "enabled": true,
    "indentWidth": 2,
    "indentStyle": "tab",
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noInferrableTypes": "off" // Sometimes it is good to over constrain the types to make it harder to change and break.
      },
      "correctness": {
        "useImportExtensions": {
          "level": "error",
          "options": {
            "forceJsExtensions": true
          }
        }
      },
      "complexity": {
        "useSimpleNumberKeys": "off" // Hex keys are sometimes preferred.
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
